  <object class="GtkAdjustment" id="autohide-speed-adjust">
    <property name="lower">0.0</property>
    <property name="upper">1.0</property>
    <property name="step-increment">0.01</property>
  </object>
  <object class="GtkStringList" id="border-thickness-model">
    <items>
      <item translatable="yes">None</item>
      <item>1px</item>
      <item>2px</item>
      <item>3px</item>
    </items>
  </object>
  <object class="GtkStringList" id="calendar-style-model">
    <items>
      <item>Overlay 1</item>
      <item>Overlay 2</item>
