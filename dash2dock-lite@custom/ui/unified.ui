          <object class="AdwActionRow" id="animation-type-row">
            <property name="visible">true</property>
            <property name="title" translatable="yes">Opening Animation</property>
            <property name="subtitle" translatable="yes">Add bounce animation on dash icons when opening new apps.</property>
            <property name="activatable-widget">open-app-animation</property>
            <child>
              <object class="GtkSwitch" id="open-app-animation">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow" id="lamp-app-animation-row">
            <property name="visible">true</property>
            <property name="title" translatable="yes">Lamp Animation</property>
            <property name="subtitle" translatable="yes">Add genie on a lamp animation on minimizing windows. Requires the [compiz-alike-magic-lamp-effect@custom] extension. WARNING! This feature is UNSTABLE. Changing this setting may require extension restart.</property>
            <property name="activatable-widget">lamp-app-animation</property>
            <child>
              <object class="GtkSwitch" id="lamp-app-animation">
                <property name="valign">center</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Magnification</property>
            <property name="subtitle" translatable="yes">Set maximum icon size when zoomed and animated.</property>
            <property name="activatable-widget">animation-magnify</property>
            <child>
              <object class="GtkScale" id="animation-magnify">
                <property name="valign">center</property>
                <property name="hexpand">true</property>
                <property name="width-request">140px</property>
                <property name="draw-value">true</property>
                <property name="value-pos">right</property>
                <property name="orientation">horizontal</property>
                <property name="digits">2</property>
                <property name="adjustment">animation-magnify-adjust</property>
              </object>
            </child>
          </object>
        </child>
        <child>
