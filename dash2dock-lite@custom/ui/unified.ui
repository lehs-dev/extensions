  <object class="AdwPreferencesPage" id="appBehavior">
    <property name="name">appBehavior</property>
    <property name="title">Application Dock</property>
    <property name="icon-name">preferences-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Animation</property>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Animate Icons</property>
